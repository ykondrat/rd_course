# Node runtime: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000

# App DB host/port — goes through the PgBouncer pooler (localhost:6432), not straight to
# Postgres (:5432); this is the pair the app actually connects with (PGHOST is required).
PGHOST=localhost
PGPORT=6432
# Least-privilege role the app connects with (required)
PGUSER=app_user
# Fallback only — the app reads the real password from secrets/db_password at runtime
PGPASSWORD=apppass
# Database name (required)
PGDATABASE=appdb
# Full connection string. The REAL value lives in the Infisical store (README →
# Configuration); this is a fake local value pointing at PgBouncer (port 6432), not
# straight at Postgres. No password on purpose — it stays a managed secret in secrets/db_password.
DATABASE_URL=postgres://app_user@localhost:6432/appdb
# Max connections in the pg pool
PG_POOL_MAX=10
# Bootstrap admin (superuser) used only by db:setup/migrations — the app never uses these
PGADMIN_USER=admin
PGADMIN_PASSWORD=admin-bootstrap-only

# Path to the OpenAPI contract the runtime validator loads
OPENAPI_SPEC=openapi/openapi.yaml

# Pact Broker base URL. Local compose default below is NOT a secret —
# The real cloud value comes from the Infisical store (dev env).
PACT_BROKER_URL=http://127.0.0.1:9292
# Pact Broker auth token — a SECRET. Empty for the local public-read compose broker; in CI it
# arrives via GitHub secrets, locally via the Infisical store. Never hard-code it in the repo.
PACT_BROKER_TOKEN=
# Note: the test DATABASE is NOT configured here — integration/E2E tests get their Postgres
# connection at runtime from a testcontainer (container.getConnectionUri()), never from env/secrets.